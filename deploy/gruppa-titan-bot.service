[Unit]
Description=Gruppa Titan Telegram bot (tg_bot.py)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/gruppa-titan
EnvironmentFile=/home/deploy/gruppa-titan/.env
Environment=PATH=/home/deploy/gruppa-titan/venv/bin
ExecStart=/home/deploy/gruppa-titan/venv/bin/python tg_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening (как у основного сервиса)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/deploy/gruppa-titan/instance /home/deploy/gruppa-titan/logs
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
