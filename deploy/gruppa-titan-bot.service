[Unit]
Description=Gruppa Titan Telegram bot (tg_bot.py)
After=network.target
# StartLimitIntervalSec/StartLimitBurst — директивы секции [Unit] (systemd >=230),
# а не [Service]: там systemd их не распознаёт (warning "Unknown key name
# ... in section 'Service'") и молча игнорирует, из-за чего лимит рестартов не
# работал вовсе — бот с битым токеном/прокси (Restart=on-failure) крутил
# вечный цикл рестартов каждые 10с вместо остановки после 10 попыток за 5 минут.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/gruppa-titan
EnvironmentFile=/home/deploy/gruppa-titan/.env
Environment=PATH=/home/deploy/gruppa-titan/venv/bin
ExecStart=/home/deploy/gruppa-titan/venv/bin/python tg_bot.py
# on-failure: при незаполненном токене бот выходит с кодом 0 и юнит
# останавливается, а не крутит вечный рестарт-цикл каждые 10 секунд
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening (как у основного сервиса)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/deploy/gruppa-titan/instance /home/deploy/gruppa-titan/logs
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
