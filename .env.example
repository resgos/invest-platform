SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///instance/invest.db

# Telegram-уведомления (группа админов)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Телеграм-бот для инвесторов (tg_bot.py); пусто = тот же TELEGRAM_BOT_TOKEN
